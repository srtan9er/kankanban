{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KankanBan",
  "version": "0.0.0+1",
  "identifier": "com.kankanban.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5183",
    "beforeDevCommand": "npm run build:mcp && npm run dev",
    "beforeBuildCommand": "npm run build:release-assets"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KankanBan",
        "width": 960,
        "height": 660,
        "minWidth": 480,
        "minHeight": 320,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": ["binaries/kankanban-mcp"],
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
