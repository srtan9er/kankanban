{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "KankanBan 主窗口（main）。它是方案 A 里**唯一的写者**：持有工作区会话、写盘、并广播 workspace:changed。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-emit",
    "core:event:allow-listen",
    "core:window:allow-start-dragging"
  ]
}
