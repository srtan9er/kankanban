{
  "name": "kankanban",
  "private": true,
  "version": "0.0.0+1",
  "type": "module",
  "description": "以卡片为唯一原语的项目管理工具（ARCHITECTURE.md）",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "test": "node --import ./test/tsx-hooks.mjs --test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "mcp": "node src/mcp/main.ts",
    "mcp:agent": "node scripts/mcp-agent.mjs",
    "cli": "node src/cli/main.ts",
    "dev": "node scripts/dev.mjs",
    "build:web": "vite build",
    "build:mcp": "node scripts/build-mcp.mjs",
    "build:release-assets": "npm run build:mcp && npm run build:web",
    "tauri": "tauri",
    "app": "tauri dev",
    "app:build": "tauri build",
    "icon": "node scripts/make-icon.mjs && tauri icon icon-source.png"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.9",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tauri-apps/api": "^2.11.1",
    "markdown-it": "^15.0.3",
    "postcss": "8.5.30",
    "postcss-value-parser": "4.2.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.8",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
